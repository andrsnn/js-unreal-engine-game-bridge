+void FJsEnvImpl::ApplyPendingDeletes()
+{
+    TArray<const UObjectBase*> Pending;
+    {
+        FScopeLock Lock(&PendingDeletesLock);
+        Pending = MoveTemp(PendingDeletes);
+    }
+    for (const UObjectBase* ObjectBase : Pending)
+    {
+        ApplyUObjectDeleted(ObjectBase);
+    }
